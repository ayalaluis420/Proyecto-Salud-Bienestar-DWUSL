{
  "info": {
    "name": "Salud y Bienestar - Miembro 3 - Planificación",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar Login primero. Los ID se guardan al crear registros. PUT de planes reemplaza su lista de alimentos. Ejecutar eliminaciones al final."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "objetivo_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "recordatorio_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "plan_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "alimento_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "fecha",
      "value": "2026-11-14",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Login de usuario",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"usuario@salud.test\",\n  \"password\": \"Usuario#2026\",\n  \"dispositivo\": \"Postman-Miembro3\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Respuesta correcta', () => pm.expect(pm.response.code).to.be.oneOf([200,201]));",
              "if (pm.response.code < 300) pm.collectionVariables.set('token', pm.response.json().data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Catálogo alimentos",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/alimentos?categoria=frutas"
      }
    },
    {
      "name": "03 Detalle alimento",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/alimentos/{{alimento_id}}"
      }
    },
    {
      "name": "04 Crear objetivo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/objetivos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Caminar 50 kilómetros\",\n  \"unidad\": \"km\",\n  \"valor_meta\": 50,\n  \"valor_actual\": 0,\n  \"fecha_inicio\": \"{{fecha}}\",\n  \"fecha_fin\": \"2026-12-31\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Respuesta correcta', () => pm.expect(pm.response.code).to.be.oneOf([200,201]));",
              "if (pm.response.code < 300) pm.collectionVariables.set('objetivo_id', pm.response.json().data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Consultar objetivos",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/objetivos?estado=en_curso"
      }
    },
    {
      "name": "06 Detalle objetivo",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/objetivos/{{objetivo_id}}"
      }
    },
    {
      "name": "07 Actualizar avance",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/objetivos/{{objetivo_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"valor_actual\": 50\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "08 Crear recordatorio",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/recordatorios",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Recordatorio de demostración\",\n  \"tipo\": \"vitamina\",\n  \"dosis\": \"1 unidad (dato ficticio)\",\n  \"hora\": \"08:00\",\n  \"frecuencia\": \"diaria\",\n  \"fecha_inicio\": \"{{fecha}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Respuesta correcta', () => pm.expect(pm.response.code).to.be.oneOf([200,201]));",
              "if (pm.response.code < 300) pm.collectionVariables.set('recordatorio_id', pm.response.json().data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Consultar recordatorios",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/recordatorios?activo=1"
      }
    },
    {
      "name": "10 Detalle recordatorio",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/recordatorios/{{recordatorio_id}}"
      }
    },
    {
      "name": "11 Actualizar recordatorio",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/recordatorios/{{recordatorio_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"hora\": \"09:00\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "12 Registrar toma",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/recordatorios/{{recordatorio_id}}/cumplimientos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fecha\": \"{{fecha}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "13 Quitar toma",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/recordatorios/{{recordatorio_id}}/cumplimientos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fecha\": \"{{fecha}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "14 Crear plan de comida",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/planes-comida",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fecha\": \"{{fecha}}\",\n  \"tipo\": \"merienda\",\n  \"notas\": \"Plan de prueba\",\n  \"alimentos\": [\n    {\n      \"alimento_id\": \"{{alimento_id}}\",\n      \"porciones\": 1\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Respuesta correcta', () => pm.expect(pm.response.code).to.be.oneOf([200,201]));",
              "if (pm.response.code < 300) pm.collectionVariables.set('plan_id', pm.response.json().data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "15 Consultar planes",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/planes-comida?fecha={{fecha}}"
      }
    },
    {
      "name": "16 Detalle plan",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/planes-comida/{{plan_id}}"
      }
    },
    {
      "name": "17 Actualizar plan",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/planes-comida/{{plan_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fecha\": \"{{fecha}}\",\n  \"tipo\": \"merienda\",\n  \"alimentos\": [\n    {\n      \"alimento_id\": \"{{alimento_id}}\",\n      \"porciones\": 2\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "18 Eliminar plan",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/planes-comida/{{plan_id}}"
      }
    },
    {
      "name": "19 Eliminar recordatorio",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/recordatorios/{{recordatorio_id}}"
      }
    },
    {
      "name": "20 Eliminar objetivo",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/objetivos/{{objetivo_id}}"
      }
    }
  ]
}
